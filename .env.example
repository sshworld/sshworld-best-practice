# claude-best-practice — 환경변수 예시
# 실제 값은 .env 에 복사 후 채우기. .env 는 .gitignore 에 등록됨.

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=sshworld
GIT_USER_NAME=sshworld
GIT_USER_EMAIL=you@example.com
GH_REPO_NAME=sshworld-best-practice

# 본 repo 워크플로 환경변수
# CLAUDE_TDD_STRICT=1               # TDD 위반 시 차단
# DOC_IMPACT=none                   # commit 시 DOC 영향 명시
# DISABLE_DOC_SYNC_HOOK=1           # doc-sync hook 비활성화
# DISABLE_TOKEN_STATS=1             # token-stats hook 비활성화
# CLAUDE_MAX_CHILD_PANES=5          # 자식 pane 상한 (Slice D 도입 후)
# DISABLE_PANE_LIMIT_HOOK=1         # pane 한도 hook 비활성화
# FORCE_SELF_KILL=1                 # 자기 pane kill 거부 우회
